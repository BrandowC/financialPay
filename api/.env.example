# =============================================================================
# AM Cuenta · API — Variables de entorno
# =============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# La API VALIDA todo esto al arrancar: si algo falta o está mal, no levanta y
# te dice exactamente qué corregir. Es a propósito.
# =============================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

# ── Base de datos ────────────────────────────────────────────────────────────
# En desarrollo, esta URL coincide con la de infra/docker-compose.yml.
DATABASE_URL=postgresql://amcuenta:amcuenta_dev@localhost:5432/amcuenta?schema=public

# Regla práctica: (núcleos x 2). Subirlo NO da más rendimiento; Postgres se
# degrada con muchas conexiones ociosas. Ver docs/escalabilidad.md
DATABASE_POOL_SIZE=15
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Autenticación ────────────────────────────────────────────────────────────
# GENERA LOS TUYOS. Nunca uses estos en producción:
#   openssl rand -base64 48
# Deben ser DISTINTOS entre sí y de al menos 32 caracteres.
JWT_ACCESS_SECRET=reemplaza-esto-con-openssl-rand-base64-48-minimo-32-chars
JWT_REFRESH_SECRET=otro-valor-totalmente-distinto-generado-con-openssl-rand
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=am-cuenta-api

# Bloqueo por fuerza bruta (clientes). Los administradores usan 3 y 30 min.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Redis (opcional) ─────────────────────────────────────────────────────────
# Solo hace falta si corres MÁS DE UNA instancia de la API, para que el rate
# limiting sea global y no por réplica. Con una instancia, déjalo comentado.
# REDIS_URL=redis://localhost:6379

# ── Google Sheets ────────────────────────────────────────────────────────────
# Si lo dejas en false, la API funciona igual: los registros se guardan en
# PostgreSQL y los eventos se acumulan en la tabla outbox_events. Cuando lo
# actives, se sincroniza TODO lo acumulado automáticamente. No se pierde nada.
#
# Cómo obtener estos valores: docs/google-sheets.md
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Registros
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada del JSON de la cuenta de servicio, ENTRE COMILLAS y con los
# saltos de línea como \n literales.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Worker de sincronización ─────────────────────────────────────────────────
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50

# ── CORS ─────────────────────────────────────────────────────────────────────
# El panel administrativo se sirve desde ESTA MISMA API (ver ServeStaticModule
# en app.module.ts), pero el navegador igual manda cabecera Origin en cada
# POST/PATCH/DELETE aunque sea al mismo origen — así que el propio dominio de
# esta API TIENE que estar en esta lista, o el panel se autobloquea. En
# desarrollo por eso incluye localhost:3000 (donde corre esta API). En
# producción, agrega el dominio real (ej: https://amcuenta-api.onrender.com).
# En producción NO se admiten comodines ni localhost (la API se niega a arrancar).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate limiting global ─────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Semilla del primer administrador ─────────────────────────────────────────
# Solo lo usa `npm run db:seed`. Cambia la contraseña después del primer acceso.
SEED_ADMIN_EMAIL=admin@amcuenta.com
SEED_ADMIN_PASSWORD=CambiaEstaClaveYa2026
SEED_ADMIN_NAME=Administrador General
